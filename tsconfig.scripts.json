{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "allowJs": true,
    "checkJs": false,
    "tsBuildInfoFile": ".artifacts/tsconfig.scripts.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "scripts/**/*.mjs",
    "lint/**/*.ts",
    "src/registry/item.ts",
    "src/registry/keyline/theme/tokens.ts"
  ]
}
