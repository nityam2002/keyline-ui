{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
  "jsPlugins": ["./lint/keyline-plugin.ts"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "settings": {
    "react": { "version": "19.3.1" }
  },
  // Severity policy: a rule is either an error or off; there are no warnings (`pnpm lint` runs with
  // --max-warnings 0). A rule is turned off only with the reason beside it.
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    // A destructured prop left out of a rest spread (`{ day, ...props }`) is how a component keeps it off the DOM.
    "no-unused-vars": ["error", { "ignoreRestSiblings": true }],
    "no-unused-expressions": ["error", { "allowShortCircuit": true, "allowTernary": true }],
    // React Compiler diagnostics. Keyline's components are not compiled with React Compiler, and consumers'
    // builds decide that for themselves; rules-of-hooks and exhaustive-deps cover hook correctness.
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/preserve-manual-memoization": "off",
    "react/immutability": "off",
    "react/purity": "off",
    "react/incompatible-library": "off",
    // Components put ARIA roles on the element Base UI renders, often a div or span whose native counterpart
    // (hr, fieldset, li) would bring its own layout or semantics into the frame; the role is the contract.
    "jsx-a11y/prefer-tag-over-role": "off",
    // Labels and anchor text arrive through children, spread props or Base UI's render prop, which static
    // analysis cannot follow. The axe run over every rendered part checks accessible names instead.
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/anchor-has-content": "off"
  },
  "overrides": [
    {
      "files": ["**/*.tsx", "**/*.jsx"],
      "rules": {
        "jsx-a11y/alt-text": "error",
        "jsx-a11y/anchor-is-valid": "error",
        "jsx-a11y/aria-activedescendant-has-tabindex": "error",
        "jsx-a11y/aria-props": "error",
        "jsx-a11y/aria-proptypes": "error",
        "jsx-a11y/aria-role": "error",
        "jsx-a11y/aria-unsupported-elements": "error",
        "jsx-a11y/click-events-have-key-events": "error",
        "jsx-a11y/heading-has-content": "error",
        "jsx-a11y/html-has-lang": "error",
        "jsx-a11y/iframe-has-title": "error",
        "jsx-a11y/img-redundant-alt": "error",
        "jsx-a11y/label-has-associated-control": "error",
        "jsx-a11y/media-has-caption": "error",
        "jsx-a11y/mouse-events-have-key-events": "error",
        "jsx-a11y/no-access-key": "error",
        "jsx-a11y/no-autofocus": "error",
        "jsx-a11y/no-distracting-elements": "error",
        "jsx-a11y/no-noninteractive-tabindex": "error",
        "jsx-a11y/no-redundant-roles": "error",
        "jsx-a11y/no-static-element-interactions": "error",
        "jsx-a11y/role-has-required-aria-props": "error",
        "jsx-a11y/role-supports-aria-props": "error",
        "jsx-a11y/scope": "error",
        "jsx-a11y/tabindex-no-positive": "error"
      }
    },
    {
      // Type-aware rules need declared types; in untyped .mjs files they judge inferred guesses (a loop variable
      // typed as the union of a tuple's members, a value built by new Function) and report noise. Those files
      // keep every other rule.
      "files": ["**/*.mjs", "**/*.js"],
      "rules": {
        "typescript/restrict-template-expressions": "off",
        "typescript/no-base-to-string": "off",
        "typescript/unbound-method": "off",
        "typescript/await-thenable": "off",
        "typescript/no-implied-eval": "off",
        "typescript/require-array-sort-compare": "off",
        "typescript/no-floating-promises": "off"
      }
    },
    {
      // node:test's test() returns a promise the runner tracks itself.
      "files": ["tests/**/*.test.ts"],
      "rules": { "typescript/no-floating-promises": "off" }
    },
    {
      // Browser and consumer checks test values that may be null (an attribute, a missing node's text): an
      // anchored regex fails the check with its message, where startsWith would throw instead.
      "files": ["tests/browser/**", "tests/consumer/**"],
      "rules": { "unicorn/prefer-string-starts-ends-with": "off" }
    },
    {
      // Playwright fixtures call their setup argument `use`, which is not React's use().
      "files": ["tests/browser/**"],
      "rules": { "react/rules-of-hooks": "off" }
    },
    {
      "files": ["**/src/registry/**"],
      "rules": {
        "keyline/no-radix-idioms": "error"
      }
    }
  ],
  "ignorePatterns": ["node_modules/**", "site/.next/**", "site/public/**", ".artifacts/**"]
}
