{
  "name": "keyline",
  "description": "React + TypeScript components on Base UI, distributed as a shadcn registry.",
  "homepage": "https://keyline-ui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nityam2002/keyline-ui.git"
  },
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --port 5291",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5292",
    "registry:build": "node scripts/registry/theme.ts && node scripts/registry/build.ts",
    "registry:verify": "node scripts/registry/verify.ts",
    "typecheck": "tsc -b && pnpm site:typecheck",
    "lint": "oxlint --max-warnings 0 --ignore-pattern \"tests/lint/fixtures/**\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --import ./tests/resolve-ts.ts --test \"tests/**/*.test.ts\"",
    "test:parts": "vitest run --config vitest.config.ts",
    "test:types": "tsc -p tests/types --noEmit",
    "test:browser": "playwright test",
    "test:css-order": "node scripts/css-order-check.mjs",
    "test:visual": "node scripts/visual.mjs",
    "test:consumer": "bash scripts/consumer-check.sh",
    "test:site": "node scripts/site-check.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:types && pnpm registry:build && pnpm registry:verify && pnpm test:parts && pnpm test:browser && pnpm test:css-order",
    "capture": "node scripts/capture.mjs",
    "site:dev": "next dev site --port 5293",
    "site:build": "next build site",
    "site:start": "next start site --port 5293",
    "site:typecheck": "next typegen site && tsc -p site --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.71.0",
    "react": "^19.3.1",
    "react-day-picker": "9.14.0",
    "react-dom": "^19.3.1",
    "react-is": "19.3.1",
    "react-resizable-panels": "4.14.8",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@shadcn/registry": "0.2.1",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "axe-core": "4.14.0",
    "next": "16.4.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright": "^1.65.0",
    "postcss": "^8.5.6",
    "postcss-js": "^4.0.1",
    "shadcn": "^4.23.0",
    "shiki": "4.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.33.0"
}
