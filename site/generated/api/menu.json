{
  "name": "menu",
  "title": "Menu",
  "description": "Docked menu with code cells, shortcut cells, ink cursor, destructive rows, checkbox and radio items, and submenus.",
  "whenToUse": "Use it for a list of commands opened from a trigger, with submenus and checkbox or radio rows. For choosing a form value use Select; for commands on an object use Context menu.",
  "parts": [
    {
      "name": "MenuCheckboxItem",
      "description": "",
      "props": [
        {
          "name": "description",
          "type": "ReactNode",
          "default": "",
          "required": false,
          "description": ""
        },
        {
