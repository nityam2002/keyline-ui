          "description": ""
        }
      ]
    },
    {
      "name": "MenuSurface",
      "description": "The menu's surface: Base UI's Menu.Popup with Keyline's look, without a portal or a positioner. MenuPopup uses it; so do menus positioned their own way (a context menu at the pointer, a menubar or toolbar menu docked to its row). Give it the rows below.",
      "props": [
        {
          "name": "attachWeight",
          "type": "2 | 3 | 1",
          "default": "2",
          "required": false,
          "description": "Keyline weight of the owner's shared edge: 2 for a standalone control, 1 for a cell."
        }
      ]
    },
    {
      "name": "MenuTrigger",
      "description": "The element that opens the menu. Rendered as another part (`render={<Button />}`), the element is that part's and carries its data-slot (each part sets its own after the props it is given).",
