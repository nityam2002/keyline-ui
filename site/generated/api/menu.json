          "default": "",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "MenuGroup",
      "description": "",
      "props": []
    },
    {
      "name": "MenuGroupLabel",
      "description": "",
      "props": []
    },
    {
      "name": "MenuItem",
      "description": "",
      "props": [
        {
          "name": "code",
          "type": "ReactNode",
          "default": "",
          "required": false,
          "description": "Index code shown in the leading cell; only when a key or a reference uses it."
        },
        {
          "name": "description",
          "type": "ReactNode",
          "default": "",
          "required": false,
          "description": ""
        },
        {
          "name": "shortcut",
          "type": "ReactNode",
          "default": "",
          "required": false,
          "description": ""
        },
        {
          "name": "variant",
          "type": "\"default\" | \"destructive\"",
          "default": "\"default\"",
          "required": false,
          "description": ""
        }
      ]
    },
    {
      "name": "MenuPopup",
      "description": "The menu: Base UI's Portal, Positioner and Popup in one part, with the positioner's placement props lifted. A docked surface: its shared edge sits on the owner's keyline, it unfolds from that edge, it has no cut. In a submenu it docks beside its row instead: its start border on the parent's end border, its first row level with the trigger row. It carries the configuration (cut, density, motion, theme, dir) of the place it is written, not of <body>.",
      "props": [
        {
          "name": "attachWeight",
          "type": "2 | 3 | 1",
          "default": "2",
          "required": false,
          "description": "Keyline weight of the owner's shared edge: 2 for a standalone control, 1 for a cell."
        },
        {
          "name": "container",
          "type": "HTMLElement | ShadowRoot | RefObject<HTMLElement | ShadowRoot | null>",
          "default": "",
          "required": false,
          "description": "Where the portal renders (defaults to <body>)."
        },
        {
          "name": "portalProps",
          "type": "Omit<MenuPortalProps, \"children\" | \"container\">",
          "default": "",
          "required": false,
          "description": "Props for Base UI's Menu.Portal."
        }
      ]
    },
    {
      "name": "MenuRadioGroup",
      "description": "One exclusive choice among MenuRadioItems; controlled (value, onValueChange) or uncontrolled (defaultValue).",
      "props": []
    },
    {
