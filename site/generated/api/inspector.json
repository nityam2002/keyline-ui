{
  "name": "inspector",
  "title": "Inspector",
  "description": "Non-modal contextual panel: header with the inspected object's code, key/value cells and a sticky action strip.",
  "whenToUse": "Use it to show the chosen record of a list in a panel beside it, without blocking the page. For a modal task use Dialog; for detail docked to the page edge use Sheet.",
  "parts": [
    {
      "name": "Inspector",
      "description": "Non-modal contextual panel. Its header cites the inspected object's code (e.g. R3/12) so the object and its detail share an address; the action strip is sticky and part of the frame.",
      "props": []
    },
    {
      "name": "InspectorActions",
      "description": "",
      "props": []
    },
    {
      "name": "InspectorBody",
      "description": "The inspector's scrolling body: a Keyline Scroll Area (bar on the inline-end edge, native scrolling). `className` and `style` reach the scroll area itself; `contentClassName` lays out what it holds.",
