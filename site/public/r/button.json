{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "button",
  "title": "Button",
  "description": "Framed button with affix cells, key travel and pending/done/failed signals.",
  "dependencies": [
    "@base-ui/react@1.9.0",
    "class-variance-authority"
  ],
  "registryDependencies": [
    "@keyline-ui/keyline",
    "utils"
  ],
  "files": [
    {
      "path": "src/registry/keyline/ui/button.tsx",
      "content": "\"use client\";\n\nimport * as React from \"react\";\nimport { Button as ButtonPrimitive } from \"@base-ui/react/button\";\nimport { cva, type VariantProps } from \"class-variance-authority\";\n\nimport { cn } from \"@/lib/utils\";\n\nconst buttonVariants = cva(\"kl-key kl-button\", {\n  variants: {\n    /** control: its own 2px frame. cell: fills a cell of an enclosing frame (no frame, no cut). */\n    layout: {\n      control: \"kl-ctl\",\n      cell: \"kl-button-cell\",\n    },\n    variant: {\n      secondary: \"\",\n      primary: \"kl-button-primary\",\n      destructive: \"kl-button-destructive\",\n      quiet: \"kl-button-quiet\",\n    },\n    size: {\n      default: \"\",\n      compact: \"kl-button-compact\",\n      icon: \"kl-button-icon\",\n    },\n  },\n  defaultVariants: { layout: \"control\", variant: \"secondary\", size: \"default\" },\n});\n\ntype Signal = \"idle\" | \"pending\" | \"done\" | \"failed\";\n\ntype ButtonProps = React.ComponentProps<typeof ButtonPrimitive> &\n  VariantProps<typeof buttonVariants> & {\n    /** pending: a segment runs along the bottom keyline and the button is busy.\n     *  done: a ✓ cell is inserted for a moment. failed: a ! cell is inserted at the start. */\n    signal?: Signal;\n  };\n\nfunction Button({ className, layout, variant, size, signal = \"idle\", children, disabled, ...props }: ButtonProps) {\n  const pending = signal === \"pending\";\n  return (\n    <ButtonPrimitive\n      data-slot=\"button\"\n      data-kl-layout={layout ?? \"control\"}\n      data-signal={signal === \"idle\" ? undefined : signal}\n      aria-busy={pending || undefined}\n      disabled={disabled || pending}\n      focusableWhenDisabled={pending}\n      className={cn(buttonVariants({ layout, variant, size }), className)}\n      {...props}\n    >\n      <span className=\"kl-slot kl-button-fail\" data-open={signal === \"failed\" ? \"\" : undefined} aria-hidden>\n        <span>\n          <span>!</span>\n        </span>\n      </span>\n      <span className=\"kl-button-label\">{children}</span>\n      <span className=\"kl-slot kl-button-done\" data-open={signal === \"done\" ? \"\" : undefined} aria-hidden>\n        <span>\n          <span>\n            <svg\n              className=\"kl-tick\"\n              viewBox=\"0 0 16 16\"\n              width=\"14\"\n              height=\"14\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2.25\"\n              strokeLinecap=\"square\"\n            >\n              <path pathLength={1} d=\"m3.5 8.5 3 3 6-7\" />\n            </svg>\n          </span>\n        </span>\n      </span>\n      {pending ? <span className=\"kl-pending\" aria-hidden /> : null}\n    </ButtonPrimitive>\n  );\n}\n\n/** A cell inside the button frame, divided by a keyline: counts, shortcuts, units. */\nfunction ButtonAffix({ className, ...props }: React.ComponentProps<\"span\">) {\n  return <span data-slot=\"button-affix\" className={cn(\"kl-button-affix\", className)} {...props} />;\n}\n\nexport { Button, ButtonAffix, buttonVariants };\n",
      "type": "registry:ui",
      "target": "components/keyline/ui/button.tsx"
    }
  ],
  "css": {
    "@layer components": {
      ".kl-button": {
        "display": "inline-flex",
        "align-items": "stretch",
        "min-height": "var(--kl-ctl)",
        "padding": "0",
        "background-color": "var(--kl-cell)",
        "color": "var(--kl-ink)",
        "font": "inherit",
        "font-family": "var(--kl-font)",
        "font-size": "14px",
        "font-weight": "var(--kl-weight-strong)",
        "line-height": "1",
        "max-width": "100%",
        "cursor": "pointer",
        "user-select": "none",
        "-webkit-tap-highlight-color": "transparent"
      },
      ".kl-button > .kl-button-label": {
        "display": "inline-flex",
        "align-items": "center",
        "justify-content": "center",
        "gap": "8px",
        "flex": "1",
        "min-width": "0",
        "padding": "calc(6px + var(--kl-key-y)) var(--kl-button-px, 14px) calc(6px - var(--kl-key-y))",
        "line-height": "1.2",
        "white-space": "nowrap"
      },
      ".kl-button:not(.kl-button-cell) > .kl-button-label": {
        "white-space": "normal",
        "text-wrap": "balance",
        "text-align": "start"
      },
      ".kl-button svg": {
        "flex": "none"
      },
      ".kl-button:hover": {
        "background-color": "var(--kl-tint)"
      },
      ".kl-button:active:not([data-disabled])": {
        "background-color": "var(--kl-press)"
      },
      ".kl-button.kl-key:is(:active, [data-kl-pressed]):not(:disabled):not([data-disabled]) > *": {
        "translate": "none"
      },
      ".kl-button-affix": {
        "display": "inline-flex",
        "align-items": "center",
        "justify-content": "center",
        "min-width": "calc(var(--kl-ctl) - 2 * var(--kl-bw))",
        "padding-inline": "8px",
        "margin-inline": "4px calc(-1 * var(--kl-button-px, 14px))",
        "margin-block": "calc(-6px - var(--kl-key-y)) calc(-6px + var(--kl-key-y))",
        "padding-block-start": "calc(2 * var(--kl-key-y))",
        "align-self": "stretch",
        "border-inline-start": "var(--kl-k1) solid currentColor",
        "font-weight": "var(--kl-weight-display)",
        "font-variant-numeric": "tabular-nums"
      },
      ".kl-button-affix:has(kbd), .kl-button-affix.kl-code": {
        "font-family": "var(--kl-font-mono)",
        "font-size": "11px",
        "font-weight": "500"
      },
      ".kl-button-primary": {
        "background-color": "var(--kl-cobalt)",
        "border-color": "var(--kl-cobalt)",
        "color": "var(--kl-on-cobalt)",
        "--kl-cut-line": "var(--kl-cobalt)"
      },
      ".kl-button-primary:hover": {
        "background-color": "var(--kl-cobalt-hi)",
        "border-color": "var(--kl-cobalt-hi)"
      },
      ".kl-button-primary:active:not([data-disabled])": {
        "background-color": "var(--kl-cobalt-lo)",
        "border-color": "var(--kl-cobalt-lo)"
      },
      ".kl-button-destructive": {
        "background-color": "var(--kl-red)",
        "border-color": "var(--kl-red)",
        "color": "var(--kl-on-red)",
        "--kl-cut-line": "var(--kl-red)"
      },
      ".kl-button-destructive:hover": {
        "background-color": "var(--kl-red-hi)",
        "border-color": "var(--kl-red-hi)"
      },
      ".kl-button-destructive:active:not([data-disabled])": {
        "background-color": "var(--kl-red-lo)",
        "border-color": "var(--kl-red-lo)"
      },
      ".kl-button-quiet": {
        "background-color": "transparent",
        "border-color": "transparent",
        "--kl-cut-line": "transparent"
      },
      ".kl-button-quiet > .kl-button-label": {
        "text-decoration": "underline 1px",
        "text-underline-offset": "4px"
      },
      ".kl-button-quiet:hover > .kl-button-label": {
        "text-decoration-thickness": "2px"
      },
      ".kl-button-cell": {
        "border": "0",
        "--kl-bw": "0px",
        "justify-content": "center",
        "min-height": "48px",
        "position": "relative"
      },
      ".kl-button-cell:focus-visible": {
        "outline-offset": "var(--kl-ring-in)"
      },
      ".kl-button-cell.kl-button-primary:focus-visible, .kl-button-cell.kl-button-destructive:focus-visible": {
        "outline-color": "currentColor"
      },
      ".kl-button-cell > .kl-button-label": {
        "flex": "1"
      },
      ".kl-button-cell .kl-pending": {
        "--kl-bw": "3px",
        "inset-block-end": "0"
      },
      ".kl-button-compact": {
        "min-height": "28px",
        "font-size": "13px",
        "--kl-cut-size": "var(--kl-cut-nested)",
        "--kl-button-px": "10px"
      },
      ".kl-button-compact .kl-button-affix": {
        "min-width": "26px"
      },
      ".kl-button-icon": {
        "width": "var(--kl-ctl)"
      },
      ".kl-button-icon > .kl-button-label": {
        "padding": "0"
      },
      ".kl-button[data-disabled]:not([aria-busy])": {
        "cursor": "not-allowed",
        "background-color": "var(--kl-cell)",
        "background-image": "var(--kl-hatch)",
        "border-color": "var(--kl-dis-line)",
        "color": "var(--kl-dis)",
        "--kl-cut-line": "var(--kl-dis-line)"
      },
      ".kl-button-quiet[data-disabled]:not([aria-busy])": {
        "background": "transparent",
        "border-color": "transparent"
      },
      ".kl-button[aria-busy]": {
        "cursor": "progress"
      },
      ".kl-button-done > span > span, .kl-button-fail > span > span": {
        "display": "grid",
        "place-items": "center",
        "width": "calc(var(--kl-ctl) - 2 * var(--kl-bw))",
        "height": "100%"
      },
      ".kl-button-done > span, .kl-button-fail > span": {
        "display": "flex"
      },
      ".kl-button-done > span > span": {
        "background-color": "var(--kl-yellow)",
        "color": "var(--kl-on-yellow)",
        "border-inline-start": "var(--kl-k1) solid currentColor"
      },
      ".kl-button-fail > span > span": {
        "background-color": "var(--kl-red)",
        "color": "var(--kl-on-red)",
        "font-weight": "var(--kl-weight-display)",
        "font-size": "15px",
        "border-inline-end": "var(--kl-k1) solid var(--kl-seam)"
      },
      ".kl-button[data-signal=\"failed\"]:not(.kl-button-cell)": {
        "border-color": "var(--kl-red)",
        "--kl-cut-line": "var(--kl-red)"
      },
      ".kl-button-primary .kl-button-done > span > span": {
        "border-inline-start-color": "var(--kl-on-cobalt)"
      },
      "@media (forced-colors: active)": {
        ".kl-button-primary, .kl-button-destructive": {
          "border-color": "ButtonText"
        },
        ".kl-button-done > span > span, .kl-button-fail > span > span": {
          "forced-color-adjust": "none",
          "background": "Highlight",
          "color": "HighlightText"
        }
      }
    }
  },
  "type": "registry:ui"
}