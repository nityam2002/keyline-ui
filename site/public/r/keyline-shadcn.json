{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "keyline-shadcn",
  "title": "Keyline for the whole app (opt-in)",
  "description": "Maps shadcn's semantic tokens, radius, fonts, focus ring and page body to Keyline, so stock shadcn components take Keyline's look. Not needed to use Keyline components.",
  "dependencies": [],
  "registryDependencies": [
    "@keyline-ui/keyline"
  ],
  "files": [],
  "cssVars": {
    "theme": {
      "font-sans": "var(--kl-font)",
      "font-mono": "var(--kl-font-mono)",
      "radius": "0px"
    },
    "light": {
      "background": "var(--kl-paper)",
      "foreground": "var(--kl-ink)",
      "card": "var(--kl-cell)",
      "card-foreground": "var(--kl-ink)",
      "popover": "var(--kl-raised)",
      "popover-foreground": "var(--kl-ink)",
      "primary": "var(--kl-cobalt)",
      "primary-foreground": "var(--kl-on-cobalt)",
      "secondary": "var(--kl-tint)",
      "secondary-foreground": "var(--kl-ink)",
      "muted": "var(--kl-tint)",
      "muted-foreground": "var(--kl-ink-2)",
      "accent": "var(--kl-yellow)",
      "accent-foreground": "var(--kl-on-yellow)",
      "destructive": "var(--kl-red)",
      "border": "var(--kl-seam)",
      "input": "var(--kl-line)",
      "ring": "var(--kl-focus)",
      "sidebar": "var(--kl-cell)",
      "sidebar-foreground": "var(--kl-ink)",
      "sidebar-primary": "var(--kl-cobalt)",
      "sidebar-primary-foreground": "var(--kl-on-cobalt)",
      "sidebar-accent": "var(--kl-yellow)",
      "sidebar-accent-foreground": "var(--kl-on-yellow)",
      "sidebar-border": "var(--kl-seam)",
      "sidebar-ring": "var(--kl-focus)",
      "radius": "0px"
    },
    "dark": {
      "background": "var(--kl-paper)",
      "foreground": "var(--kl-ink)",
      "card": "var(--kl-cell)",
      "card-foreground": "var(--kl-ink)",
      "popover": "var(--kl-raised)",
      "popover-foreground": "var(--kl-ink)",
      "primary": "var(--kl-cobalt)",
      "primary-foreground": "var(--kl-on-cobalt)",
      "secondary": "var(--kl-tint)",
      "secondary-foreground": "var(--kl-ink)",
      "muted": "var(--kl-tint)",
      "muted-foreground": "var(--kl-ink-2)",
      "accent": "var(--kl-yellow)",
      "accent-foreground": "var(--kl-on-yellow)",
      "destructive": "var(--kl-red)",
      "border": "var(--kl-seam)",
      "input": "var(--kl-line)",
      "ring": "var(--kl-focus)",
      "sidebar": "var(--kl-cell)",
      "sidebar-foreground": "var(--kl-ink)",
      "sidebar-primary": "var(--kl-cobalt)",
      "sidebar-primary-foreground": "var(--kl-on-cobalt)",
      "sidebar-accent": "var(--kl-yellow)",
      "sidebar-accent-foreground": "var(--kl-on-yellow)",
      "sidebar-border": "var(--kl-seam)",
      "sidebar-ring": "var(--kl-focus)"
    }
  },
  "css": {
    "[data-kl-config]": {
      "--background": "var(--kl-paper)",
      "--foreground": "var(--kl-ink)",
      "--card": "var(--kl-cell)",
      "--card-foreground": "var(--kl-ink)",
      "--popover": "var(--kl-raised)",
      "--popover-foreground": "var(--kl-ink)",
      "--primary": "var(--kl-cobalt)",
      "--primary-foreground": "var(--kl-on-cobalt)",
      "--secondary": "var(--kl-tint)",
      "--secondary-foreground": "var(--kl-ink)",
      "--muted": "var(--kl-tint)",
      "--muted-foreground": "var(--kl-ink-2)",
      "--accent": "var(--kl-yellow)",
      "--accent-foreground": "var(--kl-on-yellow)",
      "--destructive": "var(--kl-red)",
      "--border": "var(--kl-seam)",
      "--input": "var(--kl-line)",
      "--ring": "var(--kl-focus)",
      "--sidebar": "var(--kl-cell)",
      "--sidebar-foreground": "var(--kl-ink)",
      "--sidebar-primary": "var(--kl-cobalt)",
      "--sidebar-primary-foreground": "var(--kl-on-cobalt)",
      "--sidebar-accent": "var(--kl-yellow)",
      "--sidebar-accent-foreground": "var(--kl-on-yellow)",
      "--sidebar-border": "var(--kl-seam)",
      "--sidebar-ring": "var(--kl-focus)"
    },
    "@layer base": {
      ":root, .light": {
        "color-scheme": "light"
      },
      ".dark": {
        "color-scheme": "dark"
      },
      "body": {
        "background-color": "var(--kl-paper)",
        "color": "var(--kl-ink)",
        "font-family": "var(--kl-font)",
        "font-size": "var(--kl-fs)",
        "line-height": "1.4",
        "font-variant-numeric": "tabular-nums",
        "-webkit-font-smoothing": "antialiased"
      },
      ":focus-visible": {
        "outline": "2px solid var(--kl-focus)",
        "outline-offset": "2px"
      }
    },
    ".light": {
      "--background": "var(--kl-paper)",
      "--foreground": "var(--kl-ink)",
      "--card": "var(--kl-cell)",
      "--card-foreground": "var(--kl-ink)",
      "--popover": "var(--kl-raised)",
      "--popover-foreground": "var(--kl-ink)",
      "--primary": "var(--kl-cobalt)",
      "--primary-foreground": "var(--kl-on-cobalt)",
      "--secondary": "var(--kl-tint)",
      "--secondary-foreground": "var(--kl-ink)",
      "--muted": "var(--kl-tint)",
      "--muted-foreground": "var(--kl-ink-2)",
      "--accent": "var(--kl-yellow)",
      "--accent-foreground": "var(--kl-on-yellow)",
      "--destructive": "var(--kl-red)",
      "--border": "var(--kl-seam)",
      "--input": "var(--kl-line)",
      "--ring": "var(--kl-focus)",
      "--sidebar": "var(--kl-cell)",
      "--sidebar-foreground": "var(--kl-ink)",
      "--sidebar-primary": "var(--kl-cobalt)",
      "--sidebar-primary-foreground": "var(--kl-on-cobalt)",
      "--sidebar-accent": "var(--kl-yellow)",
      "--sidebar-accent-foreground": "var(--kl-on-yellow)",
      "--sidebar-border": "var(--kl-seam)",
      "--sidebar-ring": "var(--kl-focus)",
      "--radius": "0px"
    }
  },
  "type": "registry:theme"
}