{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/demo/globals.css",
    "functions": ["cn", "clsx", "cva"]
  },
  "ignorePatterns": [
    "registry.json",
    "tests/registry/surface.snapshot.json",
    "site/public/**",
    "site/.next/**",
    ".artifacts/**",
    "pnpm-lock.yaml",
    "**/*.md"
  ]
}
